# Copy to .env.local (gitignored) and fill in.
# Reference list of every env var the app reads anywhere.
# For production: set these in Vercel → Project → Settings → Environment Variables.

# ── Supabase (required) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (required for paying tiers) ──
# TEST mode: sk_test_... / whsec_... (dev). LIVE mode: sk_live_... / whsec_... (prod).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs — one per tier. Create 3 products in Stripe dashboard,
# copy the price_... IDs here. TEST and LIVE prices are DIFFERENT IDs.
STRIPE_PRICE_ANALYST=
STRIPE_PRICE_INSTITUTIONAL=
STRIPE_PRICE_ENTERPRISE=

# ── Anthropic (required for pipeline + enrichment) ──
# sk-ant-... — used by extraction + enrichment prompts
ANTHROPIC_API_KEY=

# ── Cron auth (required if Vercel Cron is enabled) ──
# Any random long string. Vercel sends it as Authorization: Bearer <value>.
# Set the SAME value in Vercel → Settings → Environment Variables.
CRON_SECRET=

# ── Market data providers (optional — graceful degradation) ──
# Yahoo: no key, used by default. Below are fallbacks.
# Finnhub (US real-time): free 60/min, register at https://finnhub.io/register
FINNHUB_API_KEY=
# Twelve Data (universal fallback): free 800/day, register at https://twelvedata.com/register
TWELVEDATA_API_KEY=
# Alpha Vantage (US historical, last resort): free 25/day, https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# EDINET (Japan filings): free with registration, https://disclosure2.edinet-fsa.go.jp/weee0020.aspx
# Needed for the 3rd-pass press-release finder's EDINET source. Deal mix doesn't require it.
EDINET_API_KEY=

# ── Optional ──
# User-Agent sent to SEC EDGAR (SEC requires UA with contact info).
# Default is good for development; override in prod to your real contact.
SEC_EDGAR_UA=
