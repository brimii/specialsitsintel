# Copier en .env.local (non commité) et remplir.

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Phase 1) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANALYST=
STRIPE_PRICE_INSTITUTIONAL=
STRIPE_PRICE_ENTERPRISE=

# ── Phase 3 — Pipeline de données ──
# Clé Anthropic (sk-ant-…) — extraction Claude
ANTHROPIC_API_KEY=
# Secret partagé pour autoriser /api/cron/run (Vercel l'envoie en Bearer)
CRON_SECRET=
# Optionnel : User-Agent SEC EDGAR (sinon valeur par défaut)
SEC_EDGAR_UA=
