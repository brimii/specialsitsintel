# Copier en .env.local (non commité) et remplir.

# ── Supabase ──
# Public — exposées au navigateur (OK, l'anon est protégée par la RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — serveur uniquement. NE JAMAIS préfixer NEXT_PUBLIC_, ne jamais committer.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Phase 1) ──
# SECRET (clé test sk_test_…) — serveur uniquement
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_…) — donné par `stripe listen` ou le dashboard
STRIPE_WEBHOOK_SECRET=
# Price IDs — remplis par `npm run stripe:setup`
STRIPE_PRICE_ANALYST=
STRIPE_PRICE_INSTITUTIONAL=
STRIPE_PRICE_ENTERPRISE=
